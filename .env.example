# Native development. Docker Compose is exercised in GitHub Actions, not required here.
APP_ENV=demo
API_HOST=127.0.0.1
API_PORT=8101
ALLOW_NETWORK_BIND=false

# sqlite URL is relative to the backend working directory when overridden.
# The default in code points at <repo>/data/app.sqlite3.
DATABASE_URL=sqlite:///../data/app.sqlite3

QDRANT_MODE=local
QDRANT_PATH=../data/qdrant
QDRANT_URL=http://127.0.0.1:6301
QDRANT_WAIT=false

EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODEL_DIR=../models/all-MiniLM-L6-v2
HF_HUB_OFFLINE=1

DEMO_DATA_DIR=../data/demo
UPLOAD_DIR=../data/uploads
SEED_ON_STARTUP=true

PARSE_TIMEOUT_SECONDS=20
UPLOAD_MAX_BYTES=8388608
